{
  "manifest_version": 3,
  "name": "panH - Privacy & Anonymity Network Hub",
  "version": "1.0.0",
  "description": "Privacy Guardian: Blocks ads & trackers, masks browser fingerprint, protects search & email, and explains why in plain language.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "panH Privacy Guardian"
  },
  "options_page": "dashboard/dashboard.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ads",
        "enabled": true,
        "path": "rules/rules_ads.json"
      },
      {
        "id": "ruleset_trackers",
        "enabled": true,
        "path": "rules/rules_trackers.json"
      },
      {
        "id": "ruleset_search",
        "enabled": true,
        "path": "rules/rules_search.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scripts/fingerprint-shield.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_scripts/cosmetic-ad-blocker.js", "content_scripts/first-party-tracker.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://mail.yahoo.com/*"
      ],
      "js": ["content_scripts/email-privacy.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "dashboard/*", "popup/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
