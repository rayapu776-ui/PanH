# panH AI Edition - Fullstack Server Environment Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# -------------------------------------------------------------
# AI API Configuration
# Add your AI API key below to enable intelligent privacy advice:
# -------------------------------------------------------------

# Option 1: Google Gemini API (Recommended)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 2: OpenAI API (Alternative)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Set default AI Provider ('gemini' or 'openai')
AI_PROVIDER=gemini

