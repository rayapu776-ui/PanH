# ==============================================================================
# panH AI Edition - AI Service Environment Template
# COPY THIS FILE TO .env AND POPULATE YOUR LOCAL CREDENTIALS.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL OR GITHUB.
# ==============================================================================

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Multi-Provider AI Credentials
GEMINI_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini

# Rate Limiting & Safety Parameters
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUESTS_PER_WINDOW=60
ENABLE_LOCAL_FALLBACK=true
