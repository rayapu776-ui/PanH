# ==============================================================================
# panH AI Edition - Git Ignore Specification
# CRITICAL SECURITY RULE: NEVER COMMIT OR UPLOAD .env FILES OR SECRETS TO GITHUB
# ==============================================================================

# 1. Environment & Secret Configuration Files
.env
.env.*
!.env.example
!.env.template

**/.env
**/.env.*
!**/.env.example
!**/.env.template

# 2. Private Keys, Certificates, Tokens & Secrets
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.kdbx
*.asc
id_rsa*
id_ed25519*
secrets.json
service-account*.json
credentials.json

# 3. Database Stores, Locks & Automated Backups
*.db
*.sqlite
*.sqlite3
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/backups/
backups/

# 4. Dependencies & Package Caches
node_modules/
jspm_packages/
.pnp
.pnp.js

# 5. Build Outputs & Distribution
dist/
build/
out/
coverage/
.nyc_output/

# 6. Runtime Logs & Temporary Stores
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.temp/
.tmp/

# 7. OS & IDE Configuration Artifacts
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
_metadata/
