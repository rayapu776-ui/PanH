# ==============================================================================
# panH AI Edition - Root Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE YOUR LOCAL CREDENTIALS.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL OR GITHUB.
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# panH AI Platform Credentials (Securely resolved on backend only)
# Normal extension users never configure raw keys in browser UI.
# ------------------------------------------------------------------------------

# Option 1: Google Gemini API (Recommended)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Option 2: OpenAI API (Alternative)
# Obtain your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Default AI Provider ('gemini' or 'openai')
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Database & Cryptographic Secrets
# ------------------------------------------------------------------------------
DATABASE_URL=your_database_url_here
JWT_SECRET=replace_with_a_secure_secret
BACKUP_ENCRYPTION_KEY=replace_with_a_secure_backup_key_optional
